# -----------------------------------------------------------------------------
# docker/.env.prod.example  ->  copy to docker/.env.prod (git-ignored)
#
# infrastructure/aws/setup-ec2.sh creates .env.prod for you with random
# secrets. Only edit by hand if you know why.
# -----------------------------------------------------------------------------

# Postgres user/password used by all services
POSTGRES_USER=banking
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# HMAC key that signs the JWTs (at least 32 bytes)
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=PT1H

# Public address of the site, e.g. http://13.234.10.20 (used for CORS)
PUBLIC_URL=http://localhost

# Port nginx listens on
HTTP_PORT=80
