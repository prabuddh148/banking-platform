# Kafka UI (provectuslabs/kafka-ui) settings.
KAFKA_CLUSTERS_0_NAME=banking-local
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:29092
KAFKA_CLUSTERS_0_ZOOKEEPER=zookeeper:2181
# Allow creating/deleting topics and producing test messages from the UI (dev only).
KAFKA_CLUSTERS_0_READONLY=false
DYNAMIC_CONFIG_ENABLED=true
# Show message values as text (our events are JSON strings).
KAFKA_CLUSTERS_0_DEFAULTKEYSERDE=String
KAFKA_CLUSTERS_0_DEFAULTVALUESERDE=String
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=info
