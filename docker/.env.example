# -----------------------------------------------------------------------------
# docker/.env.example
# Copy to docker/.env and adjust. docker compose reads docker/.env automatically
# when you run it from the docker/ folder (or pass --env-file).
# These defaults are for LOCAL DEVELOPMENT ONLY - never reuse them anywhere real.
# -----------------------------------------------------------------------------

# ---- Compose ----
COMPOSE_PROJECT_NAME=banking-platform

# ---- PostgreSQL (one server, one DB per service) ----
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
POSTGRES_PORT=5432

# ---- Security ----
# HMAC key used to sign/verify JWTs. MUST be at least 32 bytes (256 bits).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-dev-secret-key-at-least-32-bytes-long
# ISO-8601 duration
JWT_EXPIRY=PT1H

# Frontend origin(s) allowed by the gateway's CORS config (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Observability ----
# Set to true to send traces to the OpenTelemetry collector
TRACING_ENABLED=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Optional Spring profile for all services (empty = default) ----
SPRING_PROFILES_ACTIVE=

# ---- JVM options applied to every service container ----
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# ---- Host ports (change if something on your machine already uses them) ----
GATEWAY_PORT=8080
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
