# Copy to `.env.local` (git-ignored) and adjust. Restart `npm run dev` after changes.

# true  = run without a backend: services return the bundled mock data
#         (src/data/mockData.js). Log in with the same demo users.
# false = (default) call the real API gateway.
VITE_USE_MOCK=false

# Base URL of the API gateway. Leave EMPTY in development: requests go to
# /api/... on the Vite dev server, which proxies them to VITE_PROXY_TARGET.
# Set it for a production build served from another origin, e.g.
#   VITE_API_BASE_URL=http://localhost:8080
# (the gateway must then allow that origin via CORS_ALLOWED_ORIGINS).
VITE_API_BASE_URL=

# Where the dev-server proxy forwards /api (dev only, not bundled).
VITE_PROXY_TARGET=http://localhost:8080
